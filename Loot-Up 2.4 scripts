local FPSEnabled = false

local OrigLight = {
	GlobalShadows  = Lighting.GlobalShadows,
	FogEnd         = Lighting.FogEnd,
	FogStart       = Lighting.FogStart,
	Brightness     = Lighting.Brightness,
	OutdoorAmbient = Lighting.OutdoorAmbient,
}

local removedFX = {}
local removedFXParent = {}

local FXClasses = {"ParticleEmitter","Trail","Smoke","Fire","Sparkles","PointLight","SpotLight","SurfaceLight"}
local LightingFX = {"BloomEffect","BlurEffect","SunRaysEffect","ColorCorrectionEffect","DepthOfFieldEffect"}

local function EnableFPS()
	pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
	Lighting.GlobalShadows  = false
	Lighting.FogEnd         = 9e9
	Lighting.FogStart       = 9e9
	Lighting.Brightness     = 2
	Lighting.OutdoorAmbient = Color3.fromRGB(128,128,128)
	for _, obj in ipairs(Lighting:GetChildren()) do
		for _, cls in ipairs(LightingFX) do
			if obj:IsA(cls) then
				table.insert(removedFX, obj)
				table.insert(removedFXParent, obj.Parent)
				obj.Parent = nil; break
			end
		end
	end
	for _, obj in ipairs(workspace:GetDescendants()) do
		for _, cls in ipairs(FXClasses) do
			if obj:IsA(cls) then
				table.insert(removedFX, obj)
				table.insert(removedFXParent, obj.Parent)
				pcall(function() obj.Parent = nil end); break
			end
		end
	end
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("BasePart") then pcall(function() obj.CastShadow = false end) end
	end
end

local function DisableFPS()
	pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic end)
	Lighting.GlobalShadows  = OrigLight.GlobalShadows
	Lighting.FogEnd         = OrigLight.FogEnd
	Lighting.FogStart       = OrigLight.FogStart
	Lighting.Brightness     = OrigLight.Brightness
	Lighting.OutdoorAmbient = OrigLight.OutdoorAmbient
	for i, obj in ipairs(removedFX) do
		pcall(function() obj.Parent = removedFXParent[i] end)
	end
	removedFX = {}; removedFXParent = {}
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("BasePart") then pcall(function() obj.CastShadow = true end) end
	end
end

