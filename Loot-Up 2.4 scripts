-- AUTOFARM
---------------------------------------------------

local Conn
local LastAttack = 0

local function Stop()
	if Hum and Root then
		Hum:Move(Vector3.zero,true)
		Hum:MoveTo(Root.Position)
	end
end

local function Start()
	if Conn then Conn:Disconnect() end
	Conn = RunService.Heartbeat:Connect(function()
		if not Settings.Enabled then return end
		local enemy,dist = GetClosest()
		if not enemy then return end
		local eroot = Enemies[enemy]
		if not eroot then return end
		if dist > Settings.AttackRadius then
			Hum:MoveTo(eroot.Position)
		else
			Hum:Move(Root.CFrame.RightVector * Settings.OrbitSpeed, true)
			if tick() - LastAttack >= Settings.AttackDelay then
				LastAttack = tick()
				SuperFastAttack()
			end
		end
	end)
	task.spawn(function()
		while Settings.Enabled and Conn do
			ScanEnemies()
			task.wait(Settings.ScanInterval)
		end
	end)
end

local function StopFarm()
	if Conn then Conn:Disconnect(); Conn = nil end
	Stop()
end

