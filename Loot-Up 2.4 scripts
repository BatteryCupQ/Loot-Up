local ESPEnabled     = { Players = false, Mobs = false }
local ESP_COLOR      = Color3.fromRGB(200, 0, 0)       -- красный
local ESP_TEXT_COLOR = Color3.fromRGB(220, 220, 220)   -- белый текст
local ESP_DIST_COLOR = Color3.fromRGB(255, 80, 80)     -- красноватый для дистанции

local function GetRootPart(model)
	if not model then return nil end
	return model:FindFirstChild("HumanoidRootPart")
		or model:FindFirstChild("Torso")
		or model:FindFirstChild("Head")
end

local function W2S(pos)
	local sp = Camera:WorldToScreenPoint(pos)
	return Vector2.new(sp.X, sp.Y), sp.Z > 0
end

-- Рисуем 2D бокс из 4 линий
local function DrawBox2D(cx, cy, w, h, color)
	local corners = {
		{cx - w/2, cy - h/2, cx + w/2, cy - h/2}, -- top
		{cx + w/2, cy - h/2, cx + w/2, cy + h/2}, -- right
		{cx + w/2, cy + h/2, cx - w/2, cy + h/2}, -- bottom
		{cx - w/2, cy + h/2, cx - w/2, cy - h/2}, -- left
	}
	for _, c in ipairs(corners) do
		local x1,y1,x2,y2 = c[1],c[2],c[3],c[4]
		local dx = x2 - x1
		local dy = y2 - y1
		local len = math.sqrt(dx*dx + dy*dy)
		if len < 1 then continue end
		local line = Instance.new("Frame")
		line.BackgroundColor3 = color
		line.BorderSizePixel  = 0
		line.Size             = UDim2.new(0, len, 0, 2)
		line.Position         = UDim2.new(0, x1, 0, y1)
		line.Rotation         = math.deg(math.atan2(dy, dx))
		line.ZIndex           = 3
		line.Parent           = ESPGui
	end
end

local function DrawESPText(text, color, x, y)
	local lbl = Instance.new("TextLabel")
	lbl.Size                  = UDim2.new(0, 120, 0, 16)
	lbl.Position              = UDim2.new(0, x - 60, 0, y)
	lbl.BackgroundColor3      = Color3.fromRGB(0, 0, 0)
	lbl.BackgroundTransparency = 0.6
	lbl.TextColor3            = color
	lbl.Font                  = Enum.Font.Code
	lbl.TextScaled            = true
	lbl.BorderSizePixel       = 0
	lbl.ZIndex                = 4
	lbl.Text                  = text
	lbl.Parent                = ESPGui
end

local function UpdateESP()
	pcall(function()
		-- Очищаем
		for _, obj in pairs(ESPGui:GetChildren()) do
			obj:Destroy()
		end

		if not ESPEnabled.Players and not ESPEnabled.Mobs then return end
		if not Root then return end

		-- ===== ESP ИГРОКОВ =====
		if ESPEnabled.Players then
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr == LP then continue end
				if not plr.Character then continue end

				local hum = plr.Character:FindFirstChildOfClass("Humanoid")
				if not hum or hum.Health <= 0 then continue end

				local root = GetRootPart(plr.Character)
				if not root then continue end

				local screenPos, inFront = W2S(root.Position)
				if not inFront then continue end

				local dist = (root.Position - Root.Position).Magnitude

				DrawBox2D(screenPos.X, screenPos.Y, 40, 60, ESP_COLOR)
				DrawESPText(plr.Name, ESP_TEXT_COLOR, screenPos.X, screenPos.Y - 50)
				DrawESPText(string.format("%.0fm", dist), ESP_DIST_COLOR, screenPos.X, screenPos.Y + 32)
			end
		end

		-- ===== ESP МОБОВ =====
		if ESPEnabled.Mobs then
			for model, root in pairs(Enemies) do
				if not model.Parent then continue end
				if not root then continue end

				local hum = model:FindFirstChildOfClass("Humanoid")
				if not hum or hum.Health <= 0 then continue end

				local screenPos, inFront = W2S(root.Position)
				if not inFront then continue end

				local dist = (root.Position - Root.Position).Magnitude

				-- Боксы мобов чуть светлее чтобы отличались
				DrawBox2D(screenPos.X, screenPos.Y, 38, 55, Color3.fromRGB(180, 0, 0))
				DrawESPText(model.Name, ESP_TEXT_COLOR, screenPos.X, screenPos.Y - 46)
				DrawESPText(string.format("%.0fm", dist), ESP_DIST_COLOR, screenPos.X, screenPos.Y + 28)
			end
		end
	end)
end

RunService.RenderStepped:Connect(function()
	UpdateESP()
end)

