local function SwitchTab(show)
	GlobalsPanel.Visible  = (show == "globals")
	SettingsPanel.Visible = (show == "settings")
	VisualsPanel.Visible  = (show == "visuals")
	MiscPanel.Visible     = (show == "misc")
end

GlobalsTab.MouseButton1Click:Connect(function()  SwitchTab("globals")  end)
SettingsTab.MouseButton1Click:Connect(function() SwitchTab("settings") end)
VisualsTab.MouseButton1Click:Connect(function()  SwitchTab("visuals")  end)
MiscTab.MouseButton1Click:Connect(function() RefreshPlayers(); SwitchTab("misc") end)

