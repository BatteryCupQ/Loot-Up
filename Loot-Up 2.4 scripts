local Ignore = {
	bone=true, bones=true, npc=true,
	shop=true, chest=true, spawn=true,
	dummy=true, portal=true
}

local PlayerChars = {}

local function RefreshPlayerChars()
	local t = {}
	for _,p in ipairs(Players:GetPlayers()) do
		if p.Character then t[p.Character] = true end
	end
	PlayerChars = t
end

local function IsMob(model)
	if not model:IsA("Model") then return end
	if model == Char then return end
	if PlayerChars[model] then return end
	local lower = model.Name:lower()
	for word in pairs(Ignore) do
		if lower:find(word) then return end
	end
	local hum = model:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return end
	local root =
		model:FindFirstChild("HumanoidRootPart")
		or model:FindFirstChild("UpperTorso")
		or model:FindFirstChild("Torso")
		or model:FindFirstChild("Head")
	if root then return root, model end
end

local Enemies = {}

local function ScanEnemies()
	local new = {}
	RefreshPlayerChars()
	for _,obj in ipairs(workspace:GetDescendants()) do
		local root, model = IsMob(obj)
		if root then new[model] = root end
	end
	Enemies = new
end

local function GetClosest()
	local best
	local bestDist = math.huge
	for model,root in pairs(Enemies) do
		local dist = (root.Position - Root.Position).Magnitude
		if dist < bestDist and dist <= Settings.Radius then
			best = model
			bestDist = dist
		end
	end
	return best, bestDist
end

