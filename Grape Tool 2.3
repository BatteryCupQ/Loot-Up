Scroll.ScrollBarThickness = 5
Scroll.Parent = MiscPanel

local Layout = Instance.new("UIListLayout")
Layout.Padding = UDim.new(0,5)
Layout.Parent = Scroll

local function TeleportToPlayer(plr)
	if not plr.Character then
		return
	end

	local target = plr.Character:FindFirstChild("HumanoidRootPart")

	if target then
		Root.CFrame = target.CFrame + Vector3.new(0,3,0)
	end
end

local function RefreshPlayers()
	for _,v in pairs(Scroll:GetChildren()) do
		if v:IsA("TextButton") then
			v:Destroy()
		end
	end

	for _,plr in pairs(Players:GetPlayers()) do
		if plr ~= LP then
			local Btn = Instance.new("TextButton")
			Btn.Size = UDim2.new(1,-5,0,35)
			Btn.BackgroundColor3 = Color3.fromRGB(15,15,15)
			Btn.Text = "> "..plr.Name
			Btn.TextColor3 = Color3.new(1,1,1)
			Btn.Font = Enum.Font.Code
			Btn.TextScaled = true
			Btn.Parent = Scroll
			Btn.MouseButton1Click:Connect(function()
				TeleportToPlayer(plr)
			end)
		end
	end

	task.wait()
	Scroll.CanvasSize = UDim2.new(0,0,0,Layout.AbsoluteContentSize.Y + 10)
end

RefreshPlayers()

---------------------------------------------------
-- TAB LOGIC
---------------------------------------------------

local function SwitchTab(show)
	GlobalsPanel.Visible  = (show == "globals")
	SettingsPanel.Visible = (show == "settings")
	VisualsPanel.Visible  = (show == "visuals")
	MiscPanel.Visible     = (show == "misc")
end

GlobalsTab.MouseButton1Click:Connect(function()
	SwitchTab("globals")
end)

SettingsTab.MouseButton1Click:Connect(function()
	SwitchTab("settings")
end)

VisualsTab.MouseButton1Click:Connect(function()
	SwitchTab("visuals")
end)

MiscTab.MouseButton1Click:Connect(function()
	RefreshPlayers()
	SwitchTab("misc")
end)

---------------------------------------------------
-- COLLAPSE LOGIC
---------------------------------------------------

local Minimized = false

Collapse.MouseButton1Click:Connect(function()
	Minimized = not Minimized

	if Minimized then
		Main.Size = UDim2.new(0,700,0,60)

		GlobalsTab.Visible = false
		SettingsTab.Visible = false
		VisualsTab.Visible = false
		MiscTab.Visible = false

		GlobalsPanel.Visible = false
		SettingsPanel.Visible = false
		VisualsPanel.Visible = false
		MiscPanel.Visible = false

		Collapse.Text = ">"
	else
		Main.Size = UDim2.new(0,700,0,420)

		GlobalsTab.Visible = true
		SettingsTab.Visible = true
		VisualsTab.Visible = true
		MiscTab.Visible = true

		GlobalsPanel.Visible = true

		Collapse.Text = "<"
	end
end)

