FarmBtn.MouseButton1Click:Connect(function()
	Settings.Enabled = not Settings.Enabled

	if Settings.Enabled then
		FarmBtn.Text = "> AutoFarm ON"
		Start()
	else
		FarmBtn.Text = "> AutoFarm OFF"
		StopFarm()
	end
end)

NoclipBtn.MouseButton1Click:Connect(function()
