	},
	red = {
		Ambient        = Color3.fromRGB(90,  0,  0),
		OutdoorAmbient = Color3.fromRGB(120, 0,  0),
	},
	white = {
		Ambient        = Color3.fromRGB(180,180,180),
		OutdoorAmbient = Color3.fromRGB(200,200,200),
	},
}

local origSky    = Lighting:FindFirstChildOfClass("Sky")
local origAmbient       = Lighting.Ambient
local origOutdoorAmbient = Lighting.OutdoorAmbient

local function SetSky(name)
	if currentSky then
		currentSky:Destroy()
		currentSky = nil
	end
	if origSky and name == nil then
		origSky.Parent = Lighting
		Lighting.Ambient        = origAmbient
		Lighting.OutdoorAmbient = origOutdoorAmbient
		return
	end
	if name == nil then return end

	if origSky then origSky.Parent = nil end

	local sky = Instance.new("Sky")
	local data = Skies[name]
	for prop, val in pairs(data) do
		pcall(function() sky[prop] = val end)
	end
  	sky.Parent = Lighting
	currentSky = sky

	local col = SkyColors[name]
	if col then
		Lighting.Ambient        = col.Ambient
		Lighting.OutdoorAmbient = col.OutdoorAmbient
	end
end

