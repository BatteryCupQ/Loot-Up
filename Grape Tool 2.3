local function ShowGreeting()
	local notifGui = Instance.new("ScreenGui")
	notifGui.Name = "GreetingNotif"
	notifGui.Parent = CoreGui
	notifGui.ResetOnSpawn = false

	local notifFrame = Instance.new("Frame")
	notifFrame.Size = UDim2.new(0, 400, 0, 80)
	notifFrame.Position = UDim2.new(1, 20, 0.5, -40)
	notifFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	notifFrame.BackgroundTransparency = 0.3
	notifFrame.BorderColor3 = Color3.fromRGB(255, 0, 0)
	notifFrame.BorderSizePixel = 2
	notifFrame.Parent = notifGui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = notifFrame

	local textLabel = Instance.new("TextLabel")
	textLabel.Size = UDim2.new(1, 0, 1, 0)
	textLabel.BackgroundTransparency = 1
	textLabel.Text = "hello my little poni :)"
	textLabel.TextColor3 = Color3.new(1, 1, 1)
	textLabel.Font = Enum.Font.Code
	textLabel.TextScaled = true
	textLabel.Parent = notifFrame

	local startTime = tick()
	local animDuration = 0.6
	while tick() - startTime < animDuration do
		local progress = (tick() - startTime) / animDuration
		notifFrame.Position = UDim2.new(1 - progress * 1.2, 20, 0.5, -40)
		task.wait(0.016)
	end
	notifFrame.Position = UDim2.new(-0.2, 20, 0.5, -40)

	task.wait(2)

	local fadeStart = tick()
	local fadeDuration = 0.4
	while tick() - fadeStart < fadeDuration do
		local fadeProg = (tick() - fadeStart) / fadeDuration
		notifFrame.BackgroundTransparency = 0.3 + (fadeProg * 0.7)
		textLabel.TextTransparency = fadeProg
		task.wait(0.016)
	end

	notifGui:Destroy()
end

task.spawn(ShowGreeting)

