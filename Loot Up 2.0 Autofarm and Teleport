---------------------------------------------------
-- FAST ATTACK
---------------------------------------------------

local attacking = false

local function SuperFastAttack()

	if attacking then
		return
	end

	attacking = true

	task.spawn(function()

		for i = 1, 5 do

			VIM:SendMouseButtonEvent(
				0,
				0,
				0,
				true,
				game,
				0
			)

			task.wait(0.015)

			VIM:SendMouseButtonEvent(
				0,
				0,
				0,
				false,
				game,
				0
			)

			task.wait(0.01)

		end

		attacking = false

	end)
end

