---------------------------------------------------
-- TELEPORT FUNCTION
---------------------------------------------------

local function TeleportToPlayer(plr)

	if not plr then
		return
	end

	if not plr.Character then
		return
	end

	local targetRoot =
		plr.Character:FindFirstChild("HumanoidRootPart")

	if not targetRoot then
		return
	end

	if Root then
		Root.CFrame =
			targetRoot.CFrame + Vector3.new(0,3,0)
	end
end

