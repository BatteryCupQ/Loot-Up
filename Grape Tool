---------------------------------------------------
-- MOBS
---------------------------------------------------

local Ignore = {
	bone = true,
	bones = true,
	npc = true,
	shop = true,
	chest = true,
	spawn = true,
	dummy = true,
	portal = true
}

local PlayerChars = {}

local function RefreshPlayerChars()

	local t = {}

	for _,p in ipairs(Players:GetPlayers()) do
		if p.Character then
			t[p.Character] = true
		end
	end

	PlayerChars = t
end

local function IsMob(model)

	if not model:IsA("Model") then
		return
	end

	if model == Char then
		return
	end

	if PlayerChars[model] then
		return
	end

	local lower = model.Name:lower()

	for word in pairs(Ignore) do
		if lower:find(word) then
			return
		end
	end

	local hum = model:FindFirstChildOfClass("Humanoid")

	if not hum or hum.Health <= 0 then
		return
	end

	local root =
		model:FindFirstChild("HumanoidRootPart")
		or model:FindFirstChild("UpperTorso")
		or model:FindFirstChild("Torso")
		or model:FindFirstChild("Head")

	if root then
		return root, model
	end
end

local Enemies = {}

local function ScanEnemies()

	local new = {}

	RefreshPlayerChars()

	for _,obj in ipairs(workspace:GetDescendants()) do

		local root, model = IsMob(obj)

		if root then
			new[model] = root
		end
	end

	Enemies = new
end

local function GetClosest()

	local best
	local bestDist = math.huge

	for model,root in pairs(Enemies) do

		local dist =
			(root.Position - Root.Position).Magnitude

		if dist < bestDist
		and dist <= Settings.Radius then

			best = model
			bestDist = dist
		end
	end

	return best, bestDist
end

---------------------------------------------------
-- AUTOFARM
---------------------------------------------------

local Conn
local LastAttack = 0

local function Stop()

	if Hum and Root then
		Hum:Move(Vector3.zero,true)
		Hum:MoveTo(Root.Position)
	end
end

local function Start()

	if Conn then
		Conn:Disconnect()
	end

	Conn = RunService.Heartbeat:Connect(function()

		if not Settings.Enabled then
			return
		end

		local enemy,dist = GetClosest()

		if not enemy then
			return
		end

		local eroot = Enemies[enemy]

		if not eroot then
			return
		end

		if dist > Settings.AttackRadius then

			Hum:MoveTo(eroot.Position)

		else

			Hum:Move(
				Root.CFrame.RightVector
				* Settings.OrbitSpeed,
				true
			)

			if tick() - LastAttack >= Settings.AttackDelay then

				LastAttack = tick()

				SuperFastAttack()
			end
		end
	end)

	task.spawn(function()

		while Settings.Enabled and Conn do

			ScanEnemies()

			task.wait(Settings.ScanInterval)

		end
	end)
end

local function StopFarm()

	if Conn then
		Conn:Disconnect()
		Conn = nil
	end

	Stop()
end

